# Customs
/logs/
/server/logs/
/server/.migration/
/server/flowgate.db
/storage/
/server/storage/
/tests/
.claude
/work
/_tools
# Generated by setup.sh / setup.ps1 (host-specific paths — not source)
/deploy/flowgate.rendered.service
/run.bat

# Secrets / credentials (public-release hardening — never commit real secrets)
# .env is already ignored below; also catch every variant but keep the samples.
.env.*
!.env.sample
# Databases / dumps
*.db
*.sqlite
*.sqlite3
*.sql.gz
*.dump
# Private keys & certificates
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
# Misc secret stores
secrets.*
*.secret
.netrc
*.kdbx

# Frontend
/client/node_modules/
/client/dist/
/client/.vite/
.vite

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
# 0382 B0001: tests used to default their scratch to `server/.test-tmp-<n>/`,
# and the finalize commit swallowed all 261 files into main. The defaults moved
# out of the repository; this line is the cheap second layer for anything that
# still lands here (an older checkout, an explicit FLOWGATE_TEST_SCRATCH).
.test-tmp-*/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
pytest-cache-files-*/

# Translations
*.mo
*.pot

