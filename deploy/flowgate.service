[Unit]
Description=FlowGate staging (FastAPI API + built client)
After=network.target

[Service]
Type=simple
# __ROOT__ / __USER__ / __GROUP__ are filled in by setup.sh.
User=__USER__
Group=__GROUP__
# FLOWGATE_STORAGE_DIR is an OS env var (NOT a pydantic Settings field), so it
# must be injected here rather than in .env (the .env file forbids extra keys).
Environment=FLOWGATE_STORAGE_DIR=__STORAGE__
WorkingDirectory=__ROOT__/server
# Rebuild the client (client_gui: the /app screens and the sign-in page at / and /login)
# before each start so `systemctl restart flowgate` picks up FE changes (server + client in
# one command). The leading '-' stays even though client_gui is now the only client
# (flowgate.v02gui.0024): a failed rebuild must not stop the server and loop against
# Restart=always — it starts on the previous dist instead, and the build error is in the
# journal. A first install has no previous dist, which is why setup.sh/setup.ps1 and the
# Dockerfile treat the same build as fatal. '-lc' uses a login shell so node/npm from the
# user's profile (nvm, /usr/local/bin) are on PATH (systemd's default PATH lacks them).
ExecStartPre=-/bin/bash -lc '__ROOT__/client_gui/build.sh'
# Start the server through the SAME login shell as the build step. This is what
# fixes B0001: the FlowGate process (and therefore the test-run runner, which
# copies this process's os.environ) inherits the user's full profile PATH, so
# node/npm/npx and any other runtime declared in the profile resolve without
# hand-planting per-executable symlinks in /usr/local/bin every time the test
# language changes. 'exec' is required so python replaces bash and keeps the
# PID that Type=simple tracks for signalling/Restart.
ExecStart=/bin/bash -lc 'exec __ROOT__/.venv/bin/python __ROOT__/server/stg.py'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
