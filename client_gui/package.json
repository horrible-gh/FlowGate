{
  "name": "flowgate-client-gui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "check:web-notices": "node scripts/check-web-notices.mjs",
    "verify:web-notices": "npm run build && npm run check:web-notices",
    "capture:themes": "node tests/visual/themes/capture.mjs",
    "typecheck": "vue-tsc -b",
    "typecheck:app": "vue-tsc --noEmit --incremental false --composite false -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:related": "vitest related --run",
    "test:area": "node scripts/test-area.mjs",
    "test:areas:check": "node scripts/test-area.mjs --check",
    "test:area:unit": "node --test scripts/test-area-check.mjs"
  },
  "dependencies": {
    "@vue-flow/core": "1.48.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.10.0",
    "marked": "^18.0.5",
    "pinia": "^2.2.0",
    "vue": "^3.4.0",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.0"
  }
}
