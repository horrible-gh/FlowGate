# Origin(s) allowed to call this API (CORS). Blank blocks every cross-origin
# browser request (the installed client is same-origin and unaffected); set your
# real service URL(s) here (comma-separated) before exposing a separately-hosted
# client, or '*' to allow every origin. setup.sh / setup.ps1 ask for it.
ALLOWED_ORIGIN=
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Path prefix the app is served under. The setup scripts write /flowgate; this
# sample used to say /test, which silently disagreed with them (0273 NR0003 §5-4).
CONTEXT=/flowgate
# One of: sqlite3, sqlite, local, mysql, postgres (see DBType in config.py).
# This used to read `mysql/sqlite3`, which is not a valid value — copying the
# sample and starting the server by hand failed validation at boot (§5-3).
DB_TYPE=sqlite3
# sqlite/sqlite3/local only — file path for the DB. The setup scripts point this
# at <repo>/storage/flowgate.db.
DB_PATH=
# mysql / postgres only.
DB_HOST=127.0.0.1
DB_PORT=0
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_SCHEMA=
# Log every SQL statement. Honoured by all three engines (§5-2 wired this up for
# sqlite, where it had been hardcoded on). Default off since 0275 T0007: with a
# remote DB every statement printed to journald measurably slows requests —
# turn on only while debugging queries.
DB_LOG=false

# ── Connection pool (mysql / postgres only — 0288 NR0003 발견 4) ────────────
# Endpoints are sync `def`, so FastAPI runs them on the AnyIO thread pool (40
# threads). sqloader's own defaults are 5 parallel queries / pool 1..5, which
# is what B0001's "connection pool exhausted" was competing over.
# DB_MAX_PARALLEL_QUERIES is the backpressure limit: callers past it wait for a
# slot rather than failing. DB_POOL_MAX must be >= it (boot rejects otherwise);
# the surplus is reserve. DB_POOL_MIN connections stay open — at 1 the driver
# closes every returned connection above the first, i.e. a TCP reconnect per
# query under load. Blank means "use the default" for all of these.
# flowgate.v02.0137 T0004 §4-3: DB_POOL_MIN below DB_MAX_PARALLEL_QUERIES still
# opens-and-closes a TCP connection for every concurrent query above DB_POOL_MIN
# (measured: min 5 / 20 parallel -> 750 reconnects per 50 bursts of 20); equal
# values reconnect 0 times. Needs sqloader>=0.2.16 (0.2.15 ignores DB_POOL_MIN).
DB_MAX_PARALLEL_QUERIES=20
DB_POOL_MIN=20
DB_POOL_MAX=24
# Connection budget check at boot (postgres): DB_POOL_MAX x DB_SERVER_PROCESSES
# must fit in max_connections - superuser_reserved_connections -
# DB_RESERVED_CONNECTIONS. DB_SERVER_PROCESSES = FlowGate server processes that
# share this database (stg 8089, v1 8092, dev ...). Over budget is logged at
# ERROR on every boot. Blank = defaults (3 / 20).
DB_SERVER_PROCESSES=3
DB_RESERVED_CONNECTIONS=20
# Seconds to wait for a free slot before failing the request. Blank = 30.
DB_ACQUIRE_TIMEOUT=30
# postgres only: recycle a connection older than / idle longer than N seconds at
# checkout. Blank = never recycle. Set these when a proxy or the server closes
# idle connections underneath the pool.
DB_POOL_MAX_LIFETIME=
DB_POOL_MAX_IDLE=

# Listen address for server/stg.py, which deploy/flowgate.service runs (P1-2).
FLOWGATE_PORT=8089
FLOWGATE_BIND_HOST=0.0.0.0

# ── Launch knobs for server/stg.py (0275 T0007, NR0003 원인 5) ──────────────
# Dev-only auto-reload; the file-watcher used to run unconditionally in
# production. Leave false in operation.
FLOWGATE_RELOAD=false
# uvicorn worker count. Keep 1 while SSE matters: the SSE publisher is
# in-process, so events from one worker never reach subscribers on another.
FLOWGATE_WORKERS=1
# Run schema migrations + backfill scan at every boot. Set false on remote-DB
# deployments where boot latency matters and migrations run at deploy time.
AUTO_MIGRATION=true

# Only RATE_LIMIT_DEFAULT is applied today; the per-route limits below are
# declared but not yet wired to any route (0273 NR0003 §6).
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=20/hour
RATE_LIMIT_DOWNLOAD=50/hour

# NOTE: FLOWGATE_STORAGE_DIR is NOT a Settings field — pydantic forbids extra
# keys, so it must not be added to .env. It is injected as an OS env var by
# deploy/flowgate.service (Linux) and run.bat (Windows) instead.

# ── Phase 1 Token (D020) ──────────────────────────────────────
# Active pepper ID (for example, v1)
FLOWGATE_TOKEN_PEPPER_ACTIVE_ID=
# Pepper value; add one entry per ID (for example, FLOWGATE_TOKEN_PEPPER_v1=<secret>)
FLOWGATE_TOKEN_PEPPER_v1=
# Maximum inbound content payload size (bytes; default 10485760 = 10 MB).
# Must be a valid integer; a blank value falls back to the default at boot.
FLOWGATE_INBOX_CONTENT_MAX=10485760

# ── Git integration (0115) ────────────────────────────────────
# base64-encoded 32-byte AES key for stored git credentials, e.g.
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Blank = a key file is generated under the storage root on first use.
# Changing it makes stored tokens unreadable (set _PREV during rotation).
FLOWGATE_GIT_ENCRYPT_KEY=
FLOWGATE_GIT_ENCRYPT_KEY_PREV=

# ── TOTP / 2FA secret encryption (0273 P1-3) ──────────────────
# base64-encoded 32-byte AES key, same form as the git key above. The server
# BOOTS without it — the failure is deferred to the first 2FA enrolment, which
# raises RuntimeError. The setup scripts generate this automatically.
# Changing it makes already-enrolled secrets unreadable (set _PREV to rotate).
FLOWGATE_TOTP_ENCRYPT_KEY=
FLOWGATE_TOTP_ENCRYPT_KEY_PREV=

# ── Agent Registry pepper (0078 T0004) — REQUIRED for Agents ──────────────────
# HMAC key for every Agent enrollment token and Agent credential (any long random
# string, e.g. python -c "import secrets; print(secrets.token_hex(32))"). Blank:
# the server boots, but Agent token issue, `flowgate agent enroll` and heartbeat
# all answer 503 temporarily_unavailable. The setup scripts and the container
# entrypoint generate it once — except when Agents are already registered, in
# which case the ORIGINAL value must be restored by hand. Never change it: every
# registered Agent credential stops authenticating (there is no _PREV fallback).
# Back it up with the DB. FLOWGATE_AGENT_PEPPER_ID is only recorded next to each
# digest; leave it at primary.
FLOWGATE_AGENT_PEPPER=
FLOWGATE_AGENT_PEPPER_ID=primary

# ── AI provider API key encryption (0371 NR0007 §3) ───────────
# base64-encoded 32-byte AES key, same form as the two keys above. It encrypts
# ai_providers.api_key at rest, so a DB dump no longer carries usable provider
# keys. Blank = a key file is generated under the storage root on first use.
# Back it up with the DB: losing it makes stored provider keys unreadable and
# they have to be re-entered (set _PREV during rotation).
FLOWGATE_AI_ENCRYPT_KEY=
FLOWGATE_AI_ENCRYPT_KEY_PREV=
