ALLOWED_ORIGIN=*
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
CONTEXT=/test
DB_TYPE=mysql/sqlite3
DB_HOST=127.0.0.1
DB_PORT=0
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_SCHEMA=

RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=120/minute
RATE_LIMIT_DOWNLOAD=120/minute

FLOWGATE_STORAGE_DIR=

# ── Phase 1 Token (D020) ──────────────────────────────────────
# Active pepper ID (for example, v1)
FLOWGATE_TOKEN_PEPPER_ACTIVE_ID=
# Pepper value; add one entry per ID (for example, FLOWGATE_TOKEN_PEPPER_v1=<secret>)
FLOWGATE_TOKEN_PEPPER_v1=
# Maximum inbound content payload size (bytes; default 10485760 = 10 MB)
FLOWGATE_INBOX_CONTENT_MAX=
