# Origin(s) allowed to call this API (CORS). '*' allows every origin — set your
# real service URL here before exposing the server. setup.sh / setup.ps1 ask for it.
ALLOWED_ORIGIN=*
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Path prefix the app is served under. The setup scripts write /flowgate; this
# sample used to say /test, which silently disagreed with them (0273 NR0003 §5-4).
CONTEXT=/flowgate
# One of: sqlite3, sqlite, local, mysql, postgres (see DBType in config.py).
# This used to read `mysql/sqlite3`, which is not a valid value — copying the
# sample and starting the server by hand failed validation at boot (§5-3).
DB_TYPE=sqlite3
# sqlite/sqlite3/local only — file path for the DB. The setup scripts point this
# at <repo>/storage/flowgate.db.
DB_PATH=
# mysql / postgres only.
DB_HOST=127.0.0.1
DB_PORT=0
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_SCHEMA=
# Log every SQL statement. Honoured by all three engines (§5-2 wired this up for
# sqlite, where it had been hardcoded on).
DB_LOG=true

# Listen address for server/stg.py, which deploy/flowgate.service runs (P1-2).
FLOWGATE_PORT=8089
FLOWGATE_BIND_HOST=0.0.0.0

# Only RATE_LIMIT_DEFAULT is applied today; the per-route limits below are
# declared but not yet wired to any route (0273 NR0003 §6).
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=20/hour
RATE_LIMIT_DOWNLOAD=50/hour

# NOTE: FLOWGATE_STORAGE_DIR is NOT a Settings field — pydantic forbids extra
# keys, so it must not be added to .env. It is injected as an OS env var by
# deploy/flowgate.service (Linux) and run.bat (Windows) instead.

# ── Phase 1 Token (D020) ──────────────────────────────────────
# Active pepper ID (for example, v1)
FLOWGATE_TOKEN_PEPPER_ACTIVE_ID=
# Pepper value; add one entry per ID (for example, FLOWGATE_TOKEN_PEPPER_v1=<secret>)
FLOWGATE_TOKEN_PEPPER_v1=
# Maximum inbound content payload size (bytes; default 10485760 = 10 MB).
# Must be a valid integer; a blank value falls back to the default at boot.
FLOWGATE_INBOX_CONTENT_MAX=10485760

# ── Git integration (0115) ────────────────────────────────────
# base64-encoded 32-byte AES key for stored git credentials, e.g.
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Blank = a key file is generated under the storage root on first use.
# Changing it makes stored tokens unreadable (set _PREV during rotation).
FLOWGATE_GIT_ENCRYPT_KEY=
FLOWGATE_GIT_ENCRYPT_KEY_PREV=

# ── TOTP / 2FA secret encryption (0273 P1-3) ──────────────────
# base64-encoded 32-byte AES key, same form as the git key above. The server
# BOOTS without it — the failure is deferred to the first 2FA enrolment, which
# raises RuntimeError. The setup scripts generate this automatically.
# Changing it makes already-enrolled secrets unreadable (set _PREV to rotate).
FLOWGATE_TOTP_ENCRYPT_KEY=
FLOWGATE_TOTP_ENCRYPT_KEY_PREV=
