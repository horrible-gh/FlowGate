# FlowGate frontend environment
# Vite reads variables prefixed with VITE_ at build/dev time.
# Only VITE_API_BASE_URL controls where the frontend sends API requests.
# (see client/shared/api.ts getBaseUrl)

# --- Local (this PC: browser and backend on the same machine) ---
VITE_API_BASE_URL=http://127.0.0.1:8088/flowgate
